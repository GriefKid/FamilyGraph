# Copy this to the deployment secret store, not into Git.
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
ALLOWED_HOSTS=your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
ENABLE_HSTS=1
BEHIND_HTTPS_PROXY=1
USE_SQLITE=0
DB_NAME=familygraph
DB_USER=familygraph
DB_PASSWORD=replace-me
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/1

# Choose at least one provider, then verify its quota and privacy terms.
AI_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OLLAMA_ENABLED=0
AI_REQUEST_TIMEOUT=6.5
CHAT_RESPONSE_DEADLINE=8
OPENROUTER_TIMEOUT=5

# Required for password reset emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=FamilyGraph <no-reply@your-domain.example>

# Optional Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=you@example.com
