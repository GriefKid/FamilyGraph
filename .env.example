# Use the included local SQLite database for development. Set this to 0 only
# after configuring the PostgreSQL variables below.
USE_SQLITE=1
# Optional: use a separate SQLite file during a restore, for example:
# SQLITE_DB_PATH=db.sqlite3.rebuilt

# PostgreSQL settings (only used when USE_SQLITE=0).
DB_NAME=familygraph
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── AI provider ──────────────────────────────────────────────────────────
# AI_PROVIDER pins the backend and skips auto-detection. Empty = auto
# (Groq -> Mistral -> Gemini -> OpenRouter -> local Ollama).
#   groq       fast, 14,400 req/day free, works from Iran  -> GROQ_API_KEY
#   mistral    free, works from Iran                        -> MISTRAL_API_KEY
#   openrouter free models, often rate-limited (503)        -> OPENROUTER_API_KEY
#   gemini     free, blocked in Iran without a VPN          -> GEMINI_API_KEY
#   ollama     fully local, needs `ollama serve` + a model  -> OLLAMA_MODEL
AI_PROVIDER=
# In Iran without a VPN: use mistral, or a local OpenAI-compatible proxy:
#   AI_PROVIDER=custom
#   AI_BASE_URL=https://api.your-proxy.ir/v1
#   AI_API_KEY=...
#   AI_MODEL=gpt-4o-mini
# Recommended free switch - get a key at https://console.groq.com/keys :
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Do not commit your real .env file or share the key in chat.
OPENROUTER_API_KEY=

# Free local model: install Ollama, then run from the project root:
#   ollama pull qwen2.5:3b
#   ollama serve
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Smaller context and a warm model improve response latency on local hardware.
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=15m
# Seconds to wait while discovering installed local models.
OLLAMA_DISCOVERY_TIMEOUT=0.8
OLLAMA_REQUEST_TIMEOUT=6

# Hard latency budget for chat. Provider calls never get an unlimited SDK
# timeout, and the whole chat route degrades locally before the UI reaches 10s.
AI_REQUEST_TIMEOUT=6.5
CHAT_RESPONSE_DEADLINE=8
OPENROUTER_TIMEOUT=5

# Optional override. This must be valid for the active provider.
# AI_MODEL=
# Current tested OpenRouter free default: minimax/minimax-m3:free

# Deployment: set these in the host's secret/environment settings, never commit
# their values. PostgreSQL is recommended for production.
# Production settings are documented in .env.production.example.
# DEBUG=False
# DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
# ALLOWED_HOSTS=your-domain.example
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# ENABLE_HSTS=1
# BEHIND_HTTPS_PROXY=1
# USE_SQLITE=0
# DB_NAME=familygraph
# DB_USER=familygraph
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=FamilyGraph <no-reply@your-domain.example>

# Optional hybrid extraction: deterministic parsing always remains active.
# This can also be enabled from the superuser Feature Flags page.
AI_HYBRID_ENABLED=0

# Production operations. Docker Compose sets REDIS_URL automatically.
# REDIS_URL=redis://127.0.0.1:6379/1
WRITE_RATE_LIMIT=120
WRITE_RATE_LIMIT_WINDOW=60
LOG_LEVEL=INFO
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
# Optional Web Push (weekly relationship pulse). Generate with:
#   python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=you@example.com
