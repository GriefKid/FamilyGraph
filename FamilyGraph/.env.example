# FamilyGraph — environment variables
# Copy this file to .env and fill in values
# اولویت: اولین کلیدی که پیدا بشه استفاده می‌شه

# ── گزینه ۱: Mistral (توصیه شده — رایگان، بدون بلاک ایران) ──────────────
# ثبت‌نام: console.mistral.ai → API Keys → Create Key
# مدل: mistral-small-latest
MISTRAL_API_KEY=your_mistral_key_here

# ── گزینه ۲: Groq — ۱۴,۴۰۰ req/day رایگان ──────────────────────────────
# ثبت‌نام: console.groq.com (ممکنه در ایران مشکل OAuth داشته باشه)
GROQ_API_KEY=your_groq_key_here

# ── گزینه ۳: OpenRouter — ۵۰ req/day رایگان ─────────────────────────────
# ثبت‌نام: openrouter.ai/keys | کلید: sk-or-v1-...
OPENROUTER_API_KEY=your_openrouter_key_here

# ── گزینه ۴: Google Gemini (بلاک در ایران بدون VPN) ─────────────────────
# ثبت‌نام: aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your_secret_key_here
DEBUG=True
